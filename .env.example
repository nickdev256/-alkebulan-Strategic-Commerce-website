# Copy this file to .env.local and fill in the value (do not commit .env.local).
# Also add the same variable in your hosting provider's environment settings
# (e.g. Vercel → Project → Settings → Environment Variables), then redeploy.

# Formspree form ID: the part after /f/ in the form endpoint,
# e.g. https://formspree.io/f/xyzabcd → xyzabcd
VITE_FORMSPREE_FORM_ID=
